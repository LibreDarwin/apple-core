From: somestupidgirl <sunnevanattsol@gmail.com>
Subject: [PATCH] kext_tools: bless.h, and BRBLLogFunc, only where bless is

kext_tools_util.c includes <bless.h> on macOS for one function,
BRBLLogFunc(), the logging callback handed to libbless by update_boot.c
and kextd_watchvol.c.  bless.h needs apfs_snap_name_lookup_t from APFS's
unpublished apfs_fsctl.h, and every kext tool compiles this file, so all
of them -- kextfind and kextlibs included, which never touch libbless --
would be held up by it.  Both the include and the function are kept for
builds that can find bless.h.

--- a/kext_tools_util.c	2026-09-15 00:17:08
+++ b/kext_tools_util.c	2026-09-15 00:17:08
@@ -23,7 +23,9 @@
 
 #include <TargetConditionals.h>
 #if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+    #if __has_include(<bless.h>)
     #include <bless.h>
+    #endif
     #include "bootcaches.h"
 #endif  // !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
 
@@ -2106,7 +2108,7 @@
     return;
 }
 
-#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR) && __has_include(<bless.h>)
 // log helper for libbless, exported as SPI via bootroot.h
 int32_t
 BRBLLogFunc(void *refcon __unused, int32_t level, const char *string)
