From: somestupidgirl <sunnevanattsol@gmail.com>
Subject: [PATCH] kext_tools: declare os_log_with_args() without log_private.h

tool_log() hands its va_list to os_log_with_args(), which libsystem_trace
exports but only libtrace's userspace <os/log_private.h> declares -- a
header Apple do not publish.  xnu's libkern/os/log_private.h publishes
the declaration of the same function, with the same five arguments
tool_log() passes; use that where the private header is missing.

--- a/kext_tools_util.c	2026-09-15 00:17:59
+++ b/kext_tools_util.c	2026-09-15 00:17:59
@@ -41,7 +41,16 @@
 #include <IOKit/kext/OSKext.h>
 #include <IOKit/kext/OSKextPrivate.h>
 #include <sandbox/rootless.h>
+#if __has_include(<os/log_private.h>)
 #include <os/log_private.h>
+#else
+/* libtrace's userspace log_private.h is not published; the declaration is
+ * the one xnu's libkern/os/log_private.h publishes for the same function. */
+#include <os/log.h>
+#include <stdarg.h>
+void os_log_with_args(os_log_t oslog, os_log_type_t type, const char *format,
+    va_list args, void *ret_addr);
+#endif
 
 #include <sys/types.h>
 #include <sys/sysctl.h>
