+{
+	do_dump = 1;
+}
+
+static void
+set_die(sig)
+	int sig;
+{
+	do_die = 1;
+}
+
+static void
+die()
+{
+	struct rainfo *ra;
+	int i;
+	const int retrans = MAX_FINAL_RTR_ADVERTISEMENTS;
+
+	if (dflag > 1) {
+		debuglog("<%s> cease to be an advertising router\n",
+		    __func__);
+	}
+
+	for (ra = ralist; ra; ra = ra->next) {
+		ra->lifetime = 0;
+		make_packet(ra);
+	}
+	for (i = 0; i < retrans; i++) {
+		for (ra = ralist; ra; ra = ra->next)
+			ra_output(ra);
+			
+		if (retrans != 1)
+			sleep(MIN_DELAY_BETWEEN_RAS);
+	}
+	pidfile_remove(pfh);
+	exit(0);
+	/*NOTREACHED*/
+}
